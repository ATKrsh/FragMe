{
  "name": "fragme",
  "version": "5.0.0",
  "description": "Futuristic super-advanced HDD, SSD, and NVMe defragmenter and storage optimizer",
  "main": "dist-electron/main.js",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build && tsc -p tsconfig.electron.json && node copy-preload.js",
    "electron:dev": "concurrently -k \"vite\" \"tsc -p tsconfig.electron.json -w\" \"node wait-and-electron.js\"",
    "electron:build": "npm run build && electron-builder --win && node package-multifolder.js",
    "start": "electron ."
  },
  "keywords": [
    "defrag",
    "defragmenter",
    "trim",
    "ssd",
    "hdd",
    "nvme",
    "storage-optimizer",
    "electron",
    "react",
    "cyberpunk"
  ],
  "author": "ATK",
  "license": "MIT",
  "dependencies": {
    "clsx": "^2.1.1",
    "lucide-react": "^0.475.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^2.6.0"
  },
  "devDependencies": {
    "@types/node": "^22.13.4",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.2",
    "electron": "^34.2.0",
    "electron-builder": "^25.1.8",
    "postcss": "^8.5.2",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3",
    "vite": "^6.1.0"
  },
  "build": {
    "appId": "com.fragme.app",
    "productName": "FragMe",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*"
    ],
    "asar": true,
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": ["x64"]
        },
        {
          "target": "dir",
          "arch": ["x64"]
        },
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ],
      "signAndEditExecutable": false,
      "artifactName": "FragMe_v5.${ext}"
    },
    "portable": {
      "artifactName": "FragMe_v5.exe"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "FragMe",
      "artifactName": "FragMe_Setup_v5.exe",
      "uninstallDisplayName": "FragMe Storage Optimizer"
    }
  }
}
